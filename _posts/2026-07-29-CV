            border-radius: 8px;
            overflow: hidden;
            display: grid;
            grid-template-columns: 320px 1fr;
        }

        /* SIDEBAR */
        .sidebar {
            background-color: var(--primary);
            color: var(--white);
            padding: 35px 25px;
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .profile-header {
            text-align: center;
        }

        .profile-header h2 {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--white);
            margin-bottom: 4px;
        }

        .profile-header p {
            font-size: 0.85rem;
            color: var(--primary-accent);
            font-weight: 500;
        }

        .sidebar h3 {
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--primary-accent);
            border-bottom: 1px solid rgba(255,255,255,0.15);
            padding-bottom: 6px;
            margin-bottom: 12px;
        }

        .sidebar ul {
            list-style: none;
        }

        .sidebar li {
            font-size: 0.88rem;
            margin-bottom: 10px;
            color: #cbd5e1;
            display: flex;
            align-items: center;
